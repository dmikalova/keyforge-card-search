package web

import "strconv"

// SearchPage is the query page with the facets and the first batch.
templ SearchPage(v PageView) {
	@page(PageTitle(v.Query), "Search every KeyForge card by house, set, type, keyword, power, and more.", v, true) {
		<main class="search">
			if v.Missing {
				<p class="banner" role="status">The card dataset is not published yet. Check back soon.</p>
			}
			@ResultsView(v.Results)
			if v.Card != nil {
				@Zoom(*v.Card)
			} else {
				<div id="zoom" class="zoom" hidden></div>
			}
			<div id="acdata" data-json={ v.Complete } hidden></div>
			<button
				id="cardload"
				type="button"
				hidden
				data-on:click="@get('/card?id=' + encodeURIComponent(el.dataset.id) + '&p=' + (el.dataset.p || 0))"
			></button>
		</main>
	}
}

// ResultsView is the part of the page that a new query replaces.
templ ResultsView(r Results) {
	<div id="results">
		if r.Err != nil {
			<div class="error" role="alert">
				<p>{ r.Err.Msg }</p>
				<p class="mark"><code>{ r.Err.Before }<mark>{ r.Err.At }</mark>{ r.Err.After }</code></p>
				if r.Err.Suggest != "" {
					<p>Did you mean <code>{ r.Err.Suggest }</code>?</p>
				}
			</div>
		} else {
			<div class="layout">
				<aside class="facets">
					<div class="summary">
						<p class="count">
							<strong>{ commas(r.Count) }</strong>
							if r.Total > r.Count {
								of { commas(r.Total) }
							}
							{ plural(max(r.Count, r.Total), "card", "cards") }
						</p>
						<label class="size">
							Size
							<input id="size" type="range" min={ itoa(SizeMin) } max={ itoa(SizeMax) } step={ itoa(SizeStep) } value={ itoa(SizeDefault) } aria-label="Card size"/>
						</label>
					</div>
					<div class="facet-list">
						for _, g := range r.Facets {
							@facetGroup(g)
						}
					</div>
				</aside>
				<section class="results">
					<div id="grid" class="grid">
						@Tiles(r.Tiles)
					</div>
					@Sentinel(r.Next)
				</section>
			</div>
		}
	</div>
}

templ facetGroup(g FacetGroup) {
	<section class="facet">
		<h2>
			@icon(g.Icon)
			{ g.Name }
		</h2>
		<ul class="bars">
			for _, c := range g.Counts {
				@facetLink(c)
			}
		</ul>
		if len(g.More) > 0 {
			<details class="more">
				<summary>{ strconv.Itoa(len(g.More)) } more</summary>
				<ul class="bars">
					for _, c := range g.More {
						@facetLink(c)
					}
				</ul>
			</details>
		}
	</section>
}

templ facetLink(c FacetLink) {
	<li>
		<a
			href={ templ.SafeURL(c.URL) }
			class={ templ.KV("active", c.Active), templ.KV("excluded", c.Excluded) }
			aria-pressed={ strconv.FormatBool(c.Active || c.Excluded) }
			title={ toggleTitle(c) }
			data-on:click__prevent={ action("toggle", "term", c.Term) }
		>
			<span class="bar" style={ barStyle(c.Percent) }></span>
			<span class="label">
				@icon(c.Icon)
				{ c.Label }
			</span>
			<span class="n">{ strconv.Itoa(c.N) }</span>
		</a>
	</li>
}

// Tiles is a run of result tiles. A batch appends it to the grid.
templ Tiles(tiles []Tile) {
	for _, t := range tiles {
		<button
			type="button"
			class="tile"
			data-i={ strconv.Itoa(t.Index) }
			title={ t.Title + " (" + t.Caption + ")" }
			data-on:click={ "@get('/card?id=" + QueryEscape(t.ID) + "&p=" + strconv.Itoa(t.Print) + "')" }
		>
			if t.Image != "" {
				<img src={ t.Image } alt={ t.Title } loading="lazy" decoding="async" width="300" height="420"/>
			} else {
				<span class="noimage">{ t.Title }</span>
			}
		</button>
	}
}

// Sentinel asks for the next batch when it comes within two viewports of
// the screen. With no next batch, it is an empty marker.
templ Sentinel(next string) {
	if next != "" {
		<div id="sentinel" class="sentinel" data-on-intersect__once={ "@get('" + next + "')" }></div>
	} else {
		<div id="sentinel"></div>
	}
}

// Zoom is the card view: the image of one printing and every field of the
// card. A click on a set shows that printing's image and flavor text. A
// click on a card name or a related card opens that card.
templ Zoom(v CardView) {
	<div id="zoom" class="zoom" role="dialog" aria-modal="true" aria-label={ v.Title } data-card={ v.ID }>
		<div class="zoom-card">
			<figure class="zoom-image">
				if v.Current().Image != "" {
					<img id="zoom-img" src={ v.Current().Image } alt={ v.Title } width="300" height="420"/>
				} else {
					<span class="noimage">{ v.Title }</span>
				}
			</figure>
			<div class="zoom-info">
				<button type="button" class="zoom-close" aria-label="Close">
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
						<path d="M6 6l12 12M18 6L6 18"></path>
					</svg>
				</button>
				<h2>{ v.Title }</h2>
				<dl>
					@filterRow("House", []Field{v.House})
					@filterRow("Type", []Field{v.Type})
					for i, r := range v.Rarities {
						if i == 0 {
							@filterRow(plural(len(v.Rarities), "Rarity", "Rarities"), []Field{r})
						} else {
							@filterRow("", []Field{r})
						}
					}
					@filterRow("Traits", v.Traits)
					for _, f := range v.Stats {
						@filterRow(f.Label, []Field{f})
					}
					@filterRow("Keywords", v.Keywords)
					@filterRow("Abilities", v.Abilities)
					@filterRow("Enhance", v.Enhance)
					@filterRow("Flags", v.Flags)
					if len(v.Notes) > 0 {
						<dt>Notes</dt>
						<dd class="notes">
							for _, n := range v.Notes {
								<span class="note">{ n }</span>
							}
						</dd>
					}
				</dl>
				for _, p := range v.Sets {
					if len(p.Text) > 0 {
						<div class="zoom-text" data-print={ itoa(p.Index) } hidden?={ p.Index != v.Print }>
							for _, line := range p.Text {
								<p>
									@textParts(line)
								</p>
							}
						</div>
					}
				}
				<h3>{ plural(len(v.Sets), "Set", "Sets") }</h3>
				<ul class="printings">
					for _, p := range v.Sets {
						<li>
							<button type="button" class={ "printing", templ.KV("active", p.Index == v.Print) } data-img={ p.Image } data-print={ itoa(p.Index) } title={ p.Name }>
								@icon(p.SetIcon)
								<span>{ p.Label }</span>
								if p.HouseIcon.URL != "" {
									@icon(p.HouseIcon)
								}
								if p.Changed {
									@textChangedIcon()
								}
							</button>
							<button
								type="button"
								class={ "set-filter", templ.KV("active", p.Set.Active()), templ.KV("excluded", p.Set.Excluded()) }
								data-term={ p.Set.Term }
								aria-pressed={ strconv.FormatBool(p.Set.State != 0) }
								aria-label={ filterTitle(p.Set) }
								title={ filterTitle(p.Set) }
								data-on:click={ filterAction }
							>
								<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round">
									<path d="M3 4h18l-7 8v6l-4 2v-8z"></path>
								</svg>
							</button>
						</li>
					}
				</ul>
				if len(v.Sets) > 1 {
					@allSets(v)
				}
				for _, p := range v.Sets {
					if p.Artist.Term != "" {
						<p class="artist" data-print={ itoa(p.Index) } hidden?={ p.Index != v.Print }>
							<span class="artist-label">Artist</span>
							@filterButton(p.Artist)
						</p>
					}
				}
				for _, p := range v.Sets {
					<p class="flavor" data-print={ itoa(p.Index) } hidden?={ p.Index != v.Print }>
						for i, line := range p.Flavor {
							if i > 0 {
								<br/>
							}
							@textParts(line)
						}
					</p>
				}
				for _, rel := range v.Related {
					<section class="related">
						<h3>{ rel.Label }</h3>
						<ul>
							for _, rc := range rel.Cards {
								<li>
									<a class="related-card" href={ templ.SafeURL(CardURL(rc.ID)) } data-card={ rc.ID } title={ rc.Title }>
										if rc.Image != "" {
											<img src={ rc.Image } alt="" loading="lazy" width="60" height="84"/>
										}
										<span>{ rc.Title }</span>
									</a>
								</li>
							}
						</ul>
					</section>
				}
			</div>
		</div>
	</div>
}

// textParts writes runs of card text: bold trigger lists, links to the
// named cards, and plain text. templ escapes every run.
templ textParts(parts []TextPart) {
	for _, part := range parts {
		if part.Icon.URL != "" {
			<span class="ico mask text-icon" style={ part.Icon.MaskStyle() } role="img" aria-label={ part.Icon.Label } title={ part.Icon.Label }></span>
		} else if part.Changed {
			<mark class="diff">{ part.Text }</mark>
		} else if part.Bold {
			<strong>{ part.Text }</strong>
		} else if part.Link != "" {
			<a class="mention" href={ templ.SafeURL(CardURL(part.Link)) } data-card={ part.Link }>{ part.Text }</a>
		} else {
			{ part.Text }
		}
	}
}

// filterRow is a card view row of values. Each value is a filter button.
templ filterRow(label string, fs []Field) {
	if len(fs) > 0 && fs[0].Value != "" {
		<dt>{ label }</dt>
		<dd class="filters">
			for _, f := range fs {
				@filterButton(f)
			}
		</dd>
	}
}

// filterButton is one value in the card view. A click toggles its term in
// the query, and an Alt-click or a long press excludes it. The card view
// stays open with the new marks; closing it shows the new results.
templ filterButton(f Field) {
	<button
		type="button"
		class={ "cv-filter", templ.KV("active", f.Active()), templ.KV("excluded", f.Excluded()) }
		data-term={ f.Term }
		aria-pressed={ strconv.FormatBool(f.State != 0) }
		title={ filterTitle(f) }
		data-on:click={ filterAction }
	>
		@icon(f.Icon)
		{ f.Value }
	</button>
}

// QueryError is the short error line under the search bar.
templ QueryError(msg string) {
	<p id="qerror" class="qerror" role="status">{ msg }</p>
}

// icon shows an icon. An SVG icon is a mask in the text color. The icon is
// decoration: the text next to it names the value.
templ icon(i Icon) {
	if i.URL != "" {
		if i.Mask {
			<span class="ico mask" style={ i.MaskStyle() } aria-hidden="true"></span>
		} else {
			<img class="ico" src={ i.URL } alt="" aria-hidden="true" width="18" height="18"/>
		}
	} else if i.Blank {
		<span class="ico" aria-hidden="true"></span>
	}
}

// textChangedIcon marks a set chip whose printing has its own card text.
templ textChangedIcon() {
	<span class="text-changed" title="Text changed in this printing" aria-label="Text changed in this printing">
		<svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 20h4L19 9l-4-4L4 16z"></path>
			<path d="M13 7l4 4"></path>
		</svg>
	</span>
}

// allSets is the button and the view of every printing side by side: the
// image and the text, with the words that differ from the card text
// marked. The script opens and closes it; it needs no server request.
templ allSets(v CardView) {
	<button type="button" class="all-sets-toggle" aria-expanded="false" aria-controls="all-sets">All sets</button>
	<section id="all-sets" class="all-sets" hidden>
		for _, p := range v.Sets {
			<figure class="all-sets-print">
				<img src={ p.Image } alt={ p.Name } loading="lazy" width="150" height="210"/>
				<figcaption>
					@icon(p.SetIcon)
					<span title={ p.Name }>{ p.Label }</span>
					if p.HouseIcon.URL != "" {
						@icon(p.HouseIcon)
					}
					if p.Changed {
						@textChangedIcon()
					}
				</figcaption>
				<div class="all-sets-text">
					for _, line := range p.Diff {
						<p>
							@textParts(line)
						</p>
					}
				</div>
			</figure>
		}
	</section>
}
