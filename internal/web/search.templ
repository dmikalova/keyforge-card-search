package web

import "strconv"

// SearchPage is the query page with the facets and the first batch.
templ SearchPage(v PageView) {
	@page(PageTitle(v.Query), "Search every KeyForge card by house, set, type, keyword, power, and more.", v, true) {
		<main class="search">
			if v.Missing {
				<p class="banner" role="status">The card dataset is not published yet. Check back soon.</p>
			}
			@ResultsView(v.Results)
			if v.Card != nil {
				@Zoom(*v.Card)
			} else {
				<div id="zoom" class="zoom" hidden></div>
			}
			<div id="acdata" data-json={ v.Complete } hidden></div>
			<button
				id="cardload"
				type="button"
				hidden
				data-on:click="@get('/card?id=' + encodeURIComponent(el.dataset.id) + '&p=' + (el.dataset.p || 0))"
			></button>
		</main>
	}
}

// ResultsView is the part of the page that a new query replaces.
templ ResultsView(r Results) {
	<div id="results">
		if r.Err != nil {
			<div class="error" role="alert">
				<p>{ r.Err.Msg }</p>
				<p class="mark"><code>{ r.Err.Before }<mark>{ r.Err.At }</mark>{ r.Err.After }</code></p>
				if r.Err.Suggest != "" {
					<p>Did you mean <code>{ r.Err.Suggest }</code>?</p>
				}
			</div>
		} else {
			<div class="layout">
				<aside class="facets">
					<div class="summary">
						<p class="count"><strong>{ commas(r.Count) }</strong> { plural(r.Count, "card", "cards") }</p>
						<label class="size">
							Size
							<input id="size" type="range" min="120" max="300" step="20" value="180" aria-label="Card size"/>
						</label>
					</div>
					<div class="facet-list">
						for _, g := range r.Facets {
							@facetGroup(g)
						}
					</div>
				</aside>
				<section class="results">
					<div id="grid" class="grid">
						@Tiles(r.Tiles)
					</div>
					@Sentinel(r.Next)
				</section>
			</div>
		}
	</div>
}

templ facetGroup(g FacetGroup) {
	<section class="facet">
		<h2>
			@icon(g.Icon)
			{ g.Name }
		</h2>
		<ul class="bars">
			for _, c := range g.Counts {
				@facetLink(c)
			}
		</ul>
		if len(g.More) > 0 {
			<details class="more">
				<summary>{ strconv.Itoa(len(g.More)) } more</summary>
				<ul class="bars">
					for _, c := range g.More {
						@facetLink(c)
					}
				</ul>
			</details>
		}
	</section>
}

templ facetLink(c FacetLink) {
	<li>
		<a
			href={ templ.SafeURL(c.URL) }
			class={ templ.KV("active", c.Active) }
			aria-pressed={ strconv.FormatBool(c.Active) }
			title={ toggleTitle(c) }
			data-on:click__prevent={ action("toggle", "term", c.Term) }
		>
			<span class="bar" style={ barStyle(c.Percent) }></span>
			<span class="label">
				@icon(c.Icon)
				{ c.Label }
			</span>
			<span class="n">{ strconv.Itoa(c.N) }</span>
		</a>
	</li>
}

// Tiles is a run of result tiles. A batch appends it to the grid.
templ Tiles(tiles []Tile) {
	for _, t := range tiles {
		<button
			type="button"
			class="tile"
			data-i={ strconv.Itoa(t.Index) }
			title={ t.Title + " (" + t.Caption + ")" }
			data-on:click={ "@get('/card?id=" + QueryEscape(t.ID) + "&p=" + strconv.Itoa(t.Print) + "')" }
		>
			if t.Image != "" {
				<img src={ t.Image } alt={ t.Title } loading="lazy" decoding="async" width="300" height="420"/>
			} else {
				<span class="noimage">{ t.Title }</span>
			}
		</button>
	}
}

// Sentinel asks for the next batch when it comes within two viewports of
// the screen. With no next batch, it is an empty marker.
templ Sentinel(next string) {
	if next != "" {
		<div id="sentinel" class="sentinel" data-on-intersect__once={ "@get('" + next + "')" }></div>
	} else {
		<div id="sentinel"></div>
	}
}

// Zoom is the card view: the image of one printing and every field of the
// card. A click on a set shows that printing's image and flavor text. A
// click on a card name or a related card opens that card.
templ Zoom(v CardView) {
	<div id="zoom" class="zoom" role="dialog" aria-modal="true" aria-label={ v.Title } data-card={ v.ID }>
		<div class="zoom-card">
			<figure class="zoom-image">
				if v.Current().Image != "" {
					<img id="zoom-img" src={ v.Current().Image } alt={ v.Title } width="300" height="420"/>
				} else {
					<span class="noimage">{ v.Title }</span>
				}
			</figure>
			<div class="zoom-info">
				<button type="button" class="zoom-close" aria-label="Close">
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
						<path d="M6 6l12 12M18 6L6 18"></path>
					</svg>
				</button>
				<h2>{ v.Title }</h2>
				<dl>
					@iconRow("House", v.House, v.HouseIcon)
					@iconRow("Type", v.Type, v.TypeIcon)
					for i, r := range v.Rarities {
						if i == 0 {
							@iconRow(plural(len(v.Rarities), "Rarity", "Rarities"), r.Value, r.Icon)
						} else {
							@iconRow("", r.Value, r.Icon)
						}
					}
					@dlRow("Traits", v.Traits)
					for _, f := range v.Stats {
						@iconRow(f.Label, f.Value, f.Icon)
					}
					@dlRow("Keywords", v.Keywords)
					@dlRow("Abilities", v.Abilities)
					@dlRow("Enhance", v.Enhance)
					@dlRow("Flags", v.Flags)
				</dl>
				if len(v.Text) > 0 {
					<div class="zoom-text">
						for _, line := range v.Text {
							<p>
								@textParts(line)
							</p>
						}
					</div>
				}
				<h3>{ plural(len(v.Sets), "Set", "Sets") }</h3>
				<ul class="printings">
					for _, p := range v.Sets {
						<li>
							<button type="button" class={ "printing", templ.KV("active", p.Index == v.Print) } data-img={ p.Image } data-print={ itoa(p.Index) }>
								@icon(p.SetIcon)
								<span>{ p.Label }</span>
							</button>
						</li>
					}
				</ul>
				for _, p := range v.Sets {
					<p class="flavor" data-print={ itoa(p.Index) } hidden?={ p.Index != v.Print }>
						for i, line := range p.Flavor {
							if i > 0 {
								<br/>
							}
							@textParts(line)
						}
					</p>
				}
				for _, rel := range v.Related {
					<section class="related">
						<h3>{ rel.Label }</h3>
						<ul>
							for _, rc := range rel.Cards {
								<li>
									<a class="related-card" href={ templ.SafeURL(CardURL(rc.ID)) } data-card={ rc.ID } title={ rc.Title }>
										if rc.Image != "" {
											<img src={ rc.Image } alt="" loading="lazy" width="60" height="84"/>
										}
										<span>{ rc.Title }</span>
									</a>
								</li>
							}
						</ul>
					</section>
				}
			</div>
		</div>
	</div>
}

// textParts writes runs of card text: bold trigger lists, links to the
// named cards, and plain text. templ escapes every run.
templ textParts(parts []TextPart) {
	for _, part := range parts {
		if part.Icon.URL != "" {
			<span class="ico mask text-icon" style={ part.Icon.MaskStyle() } role="img" aria-label={ part.Icon.Label } title={ part.Icon.Label }></span>
		} else if part.Bold {
			<strong>{ part.Text }</strong>
		} else if part.Link != "" {
			<a class="mention" href={ templ.SafeURL(CardURL(part.Link)) } data-card={ part.Link }>{ part.Text }</a>
		} else {
			{ part.Text }
		}
	}
}

templ dlRow(label, value string) {
	if value != "" {
		<dt>{ label }</dt>
		<dd>{ value }</dd>
	}
}

// QueryError is the short error line under the search bar.
templ QueryError(msg string) {
	<p id="qerror" class="qerror" role="status">{ msg }</p>
}

// iconRow is a card view row with an icon before the value.
templ iconRow(label, value string, i Icon) {
	if value != "" {
		<dt>{ label }</dt>
		<dd>
			@icon(i)
			{ value }
		</dd>
	}
}

// icon shows an icon. An SVG icon is a mask in the text color. The icon is
// decoration: the text next to it names the value.
templ icon(i Icon) {
	if i.URL != "" {
		if i.Mask {
			<span class="ico mask" style={ i.MaskStyle() } aria-hidden="true"></span>
		} else {
			<img class="ico" src={ i.URL } alt="" aria-hidden="true" width="18" height="18"/>
		}
	} else if i.Blank {
		<span class="ico" aria-hidden="true"></span>
	}
}
