package web

// SyntaxPage explains the query language (ADR 0001). It is the full page
// at /syntax, for links and for browsers without JavaScript.
templ SyntaxPage() {
	@page("Query syntax · KeyForge card search", "The query syntax of the KeyForge card search.", PageView{}, false) {
		<main class="syntax">
			@SyntaxContent()
		</main>
	}
}

// SyntaxContent is the text of the syntax page. The page and the syntax
// modal (/syntax/content) both use it, so the text has one source.
templ SyntaxContent() {
	<h1 id="syntax-title">Query syntax</h1>
			<p>Type terms in the query box. Terms next to each other must all match. A term matches a card if one of the card's printings matches it. Each card shows its newest printing that the set, rarity, number, and flavor terms select.</p>
			<table>
				<thead><tr><th>Query</th><th>Meaning</th></tr></thead>
				<tbody>
					@row("troll", "A bare word searches the name, the text, and the flavor text.")
					@row("a b, a and b", "Both terms match.")
					@row("a or b", "One of the terms matches.")
					@row("not a, -a", "The term does not match.")
					@row("( )", "Group terms: (h:dis or h:mars) t:action.")
					@row("\"steal 2\"", "An exact phrase.")
					@row("p>=3, p:2..4", "Compare a number with = != < <= > >=, or give a range.")
					@row("k:assault>=2, k:assault:2..4", "Compare the number of a keyword or an enhance icon.")
					@row("k:assault=0, k:assault<2", "A card without the keyword has the value 0, so these find the cards without assault too. k:assault alone, >0, and !=0 find the cards with it. A keyword without a number, such as elusive, counts as 1.")
					@row("s:aoa,wc", "A comma list: one of the values matches. It works for set, house, type, rarity, trait, keyword, ability, and is.")
					@row("s:aoa s:wc", "A card with a printing in AoA and a printing in WC.")
					@row("s:aoa -s:wc", "A card in AoA that is not in WC.")
					@row(`set:"Worlds Collide"`, "A set by its code (wc), its slug (worldscollide), or its full name.")
					@row(`r:"token creature"`, "A value with a space goes in quotes. r:tokencreature is the same.")
					@row("h:ek r:r t:act", "The start of a value is enough when one value starts with it: house:ekwidon rarity:rare type:action. A whole value wins over a longer one. If more values start with it, the error lists them.")
				</tbody>
			</table>
			<h2>The search bar</h2>
			<p>The results change as you type. Click the search bar to see every field. After <code>field:</code>, the list shows the values of the field. After a field or a keyword that takes a number, such as <code>power:</code> or <code>keyword:assault</code>, the list shows the comparisons = != &lt; &lt;= &gt; &gt;= and the range form. The list completes the word at the caret, also in the middle of the query. Use the arrow keys to choose, Tab or Enter to take a suggestion, and Esc to close the list. Enter without a chosen suggestion runs the query. A click on a value in the side panel adds its term. The side panel marks each value that the query filters on, in any spelling: h:dis and house:Dis mark Dis, and s:wc, set:worldscollide, and set:"Worlds Collide" mark Worlds Collide. A click on a marked value removes that filter, or only that value from a comma list. A value that the query excludes, such as -h:dis, is struck through, and a click removes the exclusion.</p>
			<h2>Fields</h2>
			<table>
				<thead><tr><th>Field</th><th>Alias</th><th>Example</th><th>Notes</th></tr></thead>
				<tbody>
					for _, f := range syntaxFields {
						<tr>
							<td><code>{ f.Name }</code></td>
							<td><code>{ f.Alias }</code></td>
							<td><a href={ templ.SafeURL(SearchURL(f.Example)) }><code>{ f.Example }</code></a></td>
							<td>{ f.Notes }</td>
						</tr>
					}
				</tbody>
			</table>
			<h2>Flags</h2>
			<p>
				<code>is:anomaly</code> (a card with an anomaly printing), <code>is:reprint</code> (a card
				in more than one set), <code>is:changed</code> (a printing with other card text than the
				newest printing), <code>is:houseless</code>,
				<code>is:reference</code>, <code>is:tokencreature</code>, <code>is:gigantic</code>,
				<code>is:eviltwin</code>, and the houseless kinds such as <code>is:skybeast</code>.
				<code>first:gr</code> gives the cards that are new in Grim Reminders.
			</p>
			<h2>Directives</h2>
			<p>
				<code>sort:</code> takes a list of keys: name, set, house, type, rarity, power, armor,
				aember, enhance, artist (printings without an artist last). Each key sorts the ties of the keys before it. A minus sign makes one key
				descending: <a href={ templ.SafeURL(SearchURL("sort:set,-power,name")) }><code>sort:set,-power,name</code></a>.
				<code>sort:random</code> shuffles the results, alone. <code>seed:</code> fixes the random order.
				<code>order:desc</code> reverses the whole order. <code>unique:prints</code> shows each printing. <code>limit:10</code> shows the first 10 results after the sort: <code>sort:random limit:10</code> shows 10 random cards, and the seed keeps the same 10 on a reload. The count then shows 10 of the total, and the side panel counts the whole result before the limit.
				Without a <code>sort:</code>, a query with a name or a bare word sorts by the best name match:
				the whole name, then the start of the name, then the start of a word, then the rest.
				The sort by house puts the cards without a house last, in groups: anomalies, the
				houseless kinds, then the reference cards. <code>group:anomaly</code> selects one
				group.
			</p>
			<h2>Keys</h2>
			<table>
				<tbody>
					@row("/", "Go to the query box.")
					@row("Esc", "Close the card, or leave the query box.")
					@row("arrows, h j k l", "Move between cards.")
					@row("Enter", "Open the card.")
					@row("r", "Show a random card from the results.")
					@row("+ -", "Make the cards larger or smaller.")
					@row("⌘A, Ctrl+A", "In the query box, select the whole query as text, to copy it.")
					@row("Tab, Enter", "Take the suggestion of the autocomplete list.")
					@row("?", "Show the query syntax.")
				</tbody>
			</table>
}

templ row(query, meaning string) {
	<tr><td><code>{ query }</code></td><td>{ meaning }</td></tr>
}
