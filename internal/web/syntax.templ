package web

// SyntaxPage explains the query language (ADR 0001).
templ SyntaxPage() {
	@page("Query syntax · KeyForge card search", "The query syntax of the KeyForge card search.", "") {
		<main class="syntax">
			<h1>Query syntax</h1>
			<p>Type terms in the query box. Terms next to each other must all match. A term matches a card if one of the card's printings matches it. Each card shows its newest printing that the set, rarity, number, and flavor terms select.</p>
			<table>
				<thead><tr><th>Query</th><th>Meaning</th></tr></thead>
				<tbody>
					@row("troll", "A bare word searches the name, the text, and the flavor text.")
					@row("a b, a and b", "Both terms match.")
					@row("a or b", "One of the terms matches.")
					@row("not a, -a", "The term does not match.")
					@row("( )", "Group terms: (h:dis or h:mars) t:action.")
					@row("\"steal 2\"", "An exact phrase.")
					@row("p>=3, p:2..4", "Compare a number with = != < <= > >=, or give a range.")
					@row("s:aoa,wc", "A comma list: one of the values matches. It works for set, house, type, rarity, trait, keyword, and is.")
					@row("s:aoa s:wc", "A card with a printing in AoA and a printing in WC.")
					@row("s:aoa -s:wc", "A card in AoA that is not in WC.")
				</tbody>
			</table>
			<h2>Fields</h2>
			<table>
				<thead><tr><th>Field</th><th>Alias</th><th>Example</th><th>Notes</th></tr></thead>
				<tbody>
					for _, f := range syntaxFields {
						<tr>
							<td><code>{ f.Name }</code></td>
							<td><code>{ f.Alias }</code></td>
							<td><a href={ templ.SafeURL(SearchURL(f.Example)) }><code>{ f.Example }</code></a></td>
							<td>{ f.Notes }</td>
						</tr>
					}
				</tbody>
			</table>
			<h2>Flags</h2>
			<p>
				<code>is:anomaly</code> (a card with an anomaly printing), <code>is:reprint</code> (a card
				in more than one set), <code>is:houseless</code>, <code>is:multihouse</code>,
				<code>is:reference</code>, <code>is:tokencreature</code>, <code>is:gigantic</code>,
				<code>is:eviltwin</code>, and the houseless kinds such as <code>is:skybeast</code>.
				<code>first:gr</code> gives the cards that are new in Grim Reminders.
			</p>
			<h2>Directives</h2>
			<p>
				<code>sort:</code> name, set, house, type, rarity, power, armor, aember, enhance, or random.
				<code>order:desc</code> reverses the order. <code>unique:prints</code> shows each printing.
				<code>seed:</code> fixes the random order.
				<code>fuzzy:off</code> turns fuzzy name matching off, so <code>n:troll</code> matches only
				names with "troll" in them. The Fuzzy box next to the query box does the same. Without a
				<code>sort:</code>, a query with a name or a bare word sorts by the best name match.
			</p>
			<h2>Keys</h2>
			<table>
				<tbody>
					@row("/", "Go to the query box.")
					@row("Esc", "Close the card, or leave the query box.")
					@row("arrows, h j k l", "Move between cards.")
					@row("Enter", "Open the card.")
					@row("r", "Show a random card.")
					@row("+ -", "Make the cards larger or smaller.")
					@row("b", "Open or close the builder.")
					@row("?", "Show this page.")
				</tbody>
			</table>
		</main>
	}
}

templ row(query, meaning string) {
	<tr><td><code>{ query }</code></td><td>{ meaning }</td></tr>
}
