package web

// page is the HTML shell that every page shares. live is true on the search
// page: the search bar then updates the results as the user types.
templ page(title, description string, v PageView, live bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<meta name="description" content={ description }/>
			<meta property="og:type" content="website"/>
			<meta property="og:title" content={ title }/>
			<meta property="og:description" content={ description }/>
			<meta property="og:site_name" content="keyforge.cards"/>
			<meta name="theme-color" content="#2b1d33"/>
			<link rel="icon" type="image/svg+xml" href={ Asset("img/favicon.svg") }/>
			<link rel="preload" href="/static/font/TeutonFett-Regular.woff" as="font" type="font/woff" crossorigin/>
			<link rel="stylesheet" href={ Asset("css/app.css") }/>
			<script src={ Asset("js/search.js") } defer></script>
			<script type="module" src={ Asset("js/datastar.js") }></script>
		</head>
		<body data-signals={ v.Signals() }>
			<header class="top">
				<a class="brand" href="/">
					<span class="wordmark">KeyForge</span>
					<span class="sub">card search</span>
				</a>
				@SearchBar(v, live)
				<nav class="actions">
					if live {
						<button type="button" id="random" class="button" title="Random card from the results (r)" data-on:click="@get('/card?random=1')">Random</button>
					} else {
						<a id="random" class="button" href="/random" title="Random card (r)">Random</a>
					}
					@DownloadLink(v.Query)
					<a class="button round help" href="/syntax" title="Query syntax (?)" aria-label="Query syntax">?</a>
				</nav>
			</header>
			{ children... }
			<footer class="foot">
				<p>
					Unofficial fan site. KeyForge, its card text, and its card images are the property of Ghost Galaxy.
				</p>
			</footer>
		</body>
	</html>
}

// SearchBar is the query bar: a chip for each committed term, and the draft
// input. The input can sit between two chips ($pos is the index of the chip
// after it, or -1 for the end), so the user can type a term there. Without
// JavaScript, the form sends the chips and the draft.
templ SearchBar(v PageView, live bool) {
	<form
		id="bar"
		class="query"
		action="/"
		method="get"
		role="search"
		if live {
			data-on:submit__prevent={ action("commit") }
		}
	>
		<div class="chipbar" data-on:click="evt.target === el && kfsearch.placeCaret(evt)">
			@Chips(v.Chips, live)
			<input type="hidden" name="q" value={ chipQuery(v.Chips) }/>
			<input
				id="q"
				name="d"
				type="search"
				value={ v.Draft }
				placeholder={ placeholder(v.Chips) }
				autocomplete="off"
				spellcheck="false"
				enterkeyhint="search"
				aria-label="Query"
				aria-autocomplete="list"
				aria-controls="ac"
				if live {
					data-bind:draft
					data-style:order="$pos < 0 ? 100000 : 2 * $pos - 1"
					data-attr:data-pos="$pos"
					data-on:kfset__window="evt.detail.pos !== undefined && ($pos = evt.detail.pos); evt.detail.q !== undefined && ($q = evt.detail.q)"
					data-on:input__debounce.250ms={ action("type") }
					data-on:paste="setTimeout(() => kfsearch.pasted(), 0)"
					data-on:keydown={ "evt.key === 'Backspace' && $draft === '' && el.selectionStart === 0 && $pos !== 0 && " + action("pop") }
				}
			/>
			<ul id="ac" class="ac" role="listbox" hidden></ul>
		</div>
		<input type="hidden" name="fz" value="1"/>
		<button type="submit" class="primary">Search</button>
		<p id="qerror" class="qerror" role="status"></p>
	</form>
}

// Chips are the committed terms. A click on a chip's text moves it to the
// draft for editing. The × removes it. Each chip has a flex order, so the
// draft input can sit between two chips.
templ Chips(chips []Chip, live bool) {
	<span id="chips" class="chips">
		for _, c := range chips {
			<span class={ "chip", templ.KV("neg", c.Negated) } style={ chipOrder(c.Index) } data-i={ itoa(c.Index) } data-term={ c.Text }>
				if live {
					<button type="button" class="chip-text" title="Edit" data-on:click={ action("edit", "i", itoa(c.Index)) }>
						@icon(c.Icon)
						{ c.Text }
					</button>
					<button type="button" class="chip-x" aria-label={ "Remove " + c.Text } data-on:click={ action("remove", "i", itoa(c.Index)) }>×</button>
				} else {
					<span class="chip-text">{ c.Text }</span>
				}
			</span>
		}
	</span>
}

// DownloadLink downloads the results as JSON.
templ DownloadLink(q string) {
	<a id="dl" class="button round icon" href={ templ.SafeURL(JSONURL(q)) } download="cards.json" title="Download the results as JSON" aria-label="Download the results as JSON">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 4v12"></path>
			<path d="M6 11l6 6 6-6"></path>
			<path d="M5 20h14"></path>
		</svg>
	</a>
}
