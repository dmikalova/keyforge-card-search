package web

// page is the HTML shell that every page shares. live is true on the search
// page: the search bar then updates the results as the user types.
templ page(title, description string, v PageView, live bool) {
	<!DOCTYPE html>
	<html lang="en" data-size={ SizeData() } style={ TileStyle() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			if v.Meta != nil {
				<title>{ v.Meta.Title } · KeyForge card search</title>
				<meta name="description" content={ v.Meta.Description }/>
				<meta property="og:type" content="article"/>
				<meta property="og:title" content={ v.Meta.Title }/>
				<meta property="og:description" content={ v.Meta.Description }/>
				if v.Meta.Image != "" {
					<meta property="og:image" content={ v.Meta.Image }/>
					<meta property="og:image:width" content="300"/>
					<meta property="og:image:height" content="420"/>
					<meta property="og:image:alt" content={ v.Meta.Title }/>
				}
				<meta name="twitter:card" content="summary_large_image"/>
				<meta name="twitter:title" content={ v.Meta.Title }/>
				<meta name="twitter:description" content={ v.Meta.Description }/>
				if v.Meta.Image != "" {
					<meta name="twitter:image" content={ v.Meta.Image }/>
				}
			} else {
				<title>{ title }</title>
				<meta name="description" content={ description }/>
				<meta property="og:type" content="website"/>
				<meta property="og:title" content={ title }/>
				<meta property="og:description" content={ description }/>
			}
			<meta property="og:site_name" content="keyforge.cards"/>
			<meta name="theme-color" content="#2b1d33"/>
			<link rel="icon" type="image/svg+xml" href={ Asset("img/favicon.svg") }/>
			<link rel="preload" href="/static/font/TeutonFett-Regular.woff" as="font" type="font/woff" crossorigin/>
			<link rel="stylesheet" href={ Asset("css/app.css") }/>
			<script src={ Asset("js/text.js") } defer></script>
			<script src={ Asset("js/search.js") } defer></script>
			<script type="module" src={ Asset("js/datastar.js") }></script>
		</head>
		<body data-signals={ v.Signals() }>
			<header class="top">
				<a class="brand" href="/">
					<span class="wordmark">KeyForge</span>
					<span class="sub">card search</span>
				</a>
				@SearchBar(v, live)
				<nav id="actions" class="actions">
					<button type="button" id="menu" class="button round icon menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="menu-items">
						<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
							<path d="M4 7h16M4 12h16M4 17h16"></path>
						</svg>
					</button>
					<div id="menu-items" class="menu-items">
						if live {
							<button type="button" id="random" class="button random" title="Random card from the results (r)" aria-label="Random card" data-on:click="@get('/card?random=1')">
								@randomIcon()
								<span class="label">Random</span>
							</button>
						} else {
							<a id="random" class="button random" href="/random" title="Random card (r)" aria-label="Random card">
								@randomIcon()
								<span class="label">Random</span>
							</a>
						}
						@DownloadLink(v.Query)
						if v.Feedback {
							<button type="button" id="feedback" class="button round icon" title="Send feedback" aria-label="Send feedback">
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round">
									<path d="M4 5h16v11H9l-5 4z"></path>
								</svg>
								<span class="label">Feedback</span>
							</button>
						}
						<a class="button round help" href="/syntax" title="Query syntax (?)" aria-label="Query syntax">
							<span class="mark">?</span>
							<span class="label">Query syntax</span>
						</a>
					</div>
				</nav>
			</header>
			{ children... }
			if v.Feedback {
				@FeedbackDialog()
			}
			<div id="syntax-modal" class="zoom syntax-modal" role="dialog" aria-modal="true" aria-labelledby="syntax-title" hidden>
				<div class="zoom-card syntax-card">
					<button type="button" class="zoom-close" aria-label="Close">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
							<path d="M6 6l12 12M18 6L6 18"></path>
						</svg>
					</button>
					<div id="syntax-body" class="syntax"></div>
				</div>
			</div>
			<footer class="foot">
				<p>
					Unofficial fan site. KeyForge, its card text, and its card images are the property of Ghost Galaxy.
				</p>
			</footer>
		</body>
	</html>
}

// SearchBar is the query bar: one text input with the query. The results
// change as the user types. A focus or a click opens the completion list
// (#ac), which search.js fills from the completions in the page. Without
// JavaScript, the form sends the query.
templ SearchBar(v PageView, live bool) {
	<form
		id="bar"
		class="query"
		action="/"
		method="get"
		role="search"
		if live {
			data-on:submit__prevent={ action("commit") }
		}
	>
		<div class="qwrap">
			<input
				id="q"
				name="q"
				type="search"
				value={ v.Query }
				placeholder={ placeholder }
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
				enterkeyhint="search"
				aria-label="Query"
				role="combobox"
				aria-expanded="false"
				aria-autocomplete="list"
				aria-controls="ac"
				if live {
					data-bind:q
					data-on:input__debounce.250ms={ action("type") }
				}
			/>
			<ul id="ac" class="ac" role="listbox" hidden></ul>
		</div>
		<button type="submit" class="primary">Search</button>
		<p id="qerror" class="qerror" role="status"></p>
	</form>
}


// DownloadLink downloads the results as JSON.
templ DownloadLink(q string) {
	<a id="dl" class="button round icon" href={ templ.SafeURL(JSONURL(q)) } download="cards.json" title="Download the results as JSON" aria-label="Download the results as JSON">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 4v12"></path>
			<path d="M6 11l6 6 6-6"></path>
			<path d="M5 20h14"></path>
		</svg>
		<span class="label">Download JSON</span>
	</a>
}

// randomIcon is the icon of the Random button: two crossing arrows. It
// takes the place of the word when the header is narrow.
templ randomIcon() {
	<svg class="random-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M3 6h3.5c3 0 4 4 5.5 6s2.5 6 5.5 6H21"></path>
		<path d="M3 18h3.5c1.5 0 2.5-1 3.3-2.3"></path>
		<path d="M14.2 8.3C15 7 16 6 17.5 6H21"></path>
		<path d="M18 3l3 3-3 3M18 15l3 3-3 3"></path>
	</svg>
}

// FeedbackDialog is the feedback form. search.js opens it and posts the
// message to /api/feedback, with the page URL.
templ FeedbackDialog() {
	<div id="feedback-modal" class="zoom feedback-modal" role="dialog" aria-modal="true" aria-labelledby="feedback-title" hidden>
		<form id="feedback-form" class="zoom-card feedback-card">
			<button type="button" class="zoom-close" aria-label="Close">
				<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
			<h2 id="feedback-title">Feedback</h2>
			<p class="feedback-help">Report a wrong card, a bug, or an idea. The message goes to the site's maintainer with the address of this page.</p>
			<textarea id="feedback-text" name="message" rows="6" maxlength="1500" required aria-label="Feedback"></textarea>
			<div class="feedback-actions">
				<span id="feedback-status" role="status"></span>
				<button type="submit" class="primary">Send</button>
			</div>
		</form>
	</div>
}
